/* The Bridge: Apps Script backend. Set secrets in Project Settings > Script properties. */
const RACES_={Human:['Hunter','Mage','Paladin','Priest','Rogue','Warlock','Warrior'],Dwarf:['Hunter','Paladin','Priest','Rogue','Shaman','Warrior'],Gnome:['Mage','Priest','Rogue','Warlock','Warrior'],'Night Elf':['Druid','Hunter','Priest','Rogue','Warrior'],Skyborne:['Druid','Hunter','Mage','Rogue','Warrior']};
const PROFESSIONS_=['','Alchemy','Blacksmithing','Enchanting','Engineering','Herbalism','Leatherworking','Mining','Skinning','Tailoring'];
const ROLES_={Druid:['Tank','Healer','Melee DPS','Ranged DPS'],Hunter:['Ranged DPS'],Mage:['Ranged DPS'],Paladin:['Tank','Healer','Melee DPS'],Priest:['Healer','Ranged DPS'],Rogue:['Melee DPS'],Shaman:['Healer','Melee DPS','Ranged DPS'],Warlock:['Ranged DPS'],Warrior:['Tank','Melee DPS']};
const HEADERS_=['discordId','displayName','name','race','className','role','profession1','profession2','certainty','note','updatedAt'];
function config_(){const p=PropertiesService.getScriptProperties().getProperties();['SHEET_ID','DISCORD_CLIENT_ID','DISCORD_CLIENT_SECRET','DISCORD_GUILD_ID','SITE_URL'].forEach(k=>{if(!p[k])throw new Error('Missing configuration: '+k);});if(!/^https:\/\//.test(p.SITE_URL)||!p.SITE_URL.endsWith('/'))throw new Error('SITE_URL must be HTTPS and end with /.');return p;}
function doGet(e){const c=config_(),t=HtmlService.createTemplateFromFile('Bridge');t.originJson=JSON.stringify(c.SITE_URL.match(/^https:\/\/[^/]+/)[0]).replace(/</g,'\\u003c');t.channelJson=JSON.stringify(String(e.parameter.channel||'').slice(0,80)).replace(/</g,'\\u003c');return t.evaluate().setTitle('The Bridge connection').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}
function random_(){return Utilities.getUuid()+Utilities.getUuid();}
function cache_(){return CacheService.getScriptCache();}
function discord_(path,token){const response=UrlFetchApp.fetch('https://discord.com/api/v10'+path,{headers:{Authorization:'Bearer '+token},muteHttpExceptions:true});if(response.getResponseCode()!==200)throw new Error('Discord verification failed. Please log in again and ensure you belong to The Bridge.');return JSON.parse(response.getContentText());}
function membership_(token,c){const member=discord_('/users/@me/guilds/'+c.DISCORD_GUILD_ID+'/member',token);if(c.DISCORD_ROLE_ID&&!(member.roles||[]).includes(c.DISCORD_ROLE_ID))throw new Error('You need the guild member role to use this planner.');return member;}
function session_(key,c){if(typeof key!=='string'||!/^[a-f0-9-]{72}$/.test(key))throw new Error('Please log in with Discord.');const raw=cache_().get('session:'+key);if(!raw)throw new Error('Your login expired. Please log in again.');const s=JSON.parse(raw);if(Date.now()>=s.expiresAt){cache_().remove('session:'+key);throw new Error('Your login expired. Please log in again.');}const member=membership_(s.accessToken,c);s.displayName=member.nick||s.displayName;return s;}
function sheet_(c){const book=SpreadsheetApp.openById(c.SHEET_ID);let sheet=book.getSheetByName('LaunchPlans');if(!sheet){sheet=book.insertSheet('LaunchPlans');sheet.appendRow(HEADERS_);sheet.setFrozenRows(1);sheet.getRange(1,1,1,HEADERS_.length).setFontWeight('bold');}const head=sheet.getRange(1,1,1,HEADERS_.length).getValues()[0];if(JSON.stringify(head)!==JSON.stringify(HEADERS_))throw new Error('LaunchPlans headers changed. Restore the original column names.');return sheet;}
function rows_(sheet){return sheet.getLastRow()<2?[]:sheet.getRange(2,1,sheet.getLastRow()-1,HEADERS_.length).getDisplayValues().map(values=>Object.fromEntries(HEADERS_.map((k,i)=>[k,values[i]])));}
function safeCell_(value){return /^[=+\-@\t\r\n]/.test(String(value))?"'"+value:value;}
function validate_(d){if(!d||typeof d!=='object')throw new Error('Invalid plans.');const result={};for(const key of ['name','race','className','role','profession1','profession2','certainty','note']){if(typeof d[key]!=='string')throw new Error('Invalid field: '+key);result[key]=d[key].trim();}if(!/^[\p{L}][\p{L}' -]{1,23}$/u.test(result.name))throw new Error('Use 2–24 letters, spaces, apostrophes or hyphens for the character name.');if(!Object.prototype.hasOwnProperty.call(RACES_,result.race)||!RACES_[result.race].includes(result.className))throw new Error('Choose a valid Alliance race and class.');if(!ROLES_[result.className].includes(result.role))throw new Error('Choose a role available to your class.');if(!PROFESSIONS_.includes(result.profession1)||!PROFESSIONS_.includes(result.profession2)||(result.profession1&&result.profession1===result.profession2))throw new Error('Choose up to two different primary professions.');if(!['Decided','Leaning toward this','Still exploring'].includes(result.certainty)||result.note.length>200)throw new Error('Check your certainty and note length.');return result;}
function dispatch(request){try{return dispatch_(request);}catch(error){return {error:String(error.message||'Request failed.')};}}
function dispatch_(request){
 if(!request||typeof request.action!=='string')throw new Error('Invalid request.');const c=config_(),action=request.action,data=request.data||{};
 if(action==='beginAuth'){const state=random_();cache_().put('oauth:'+state,'pending',600);return {state,url:'https://discord.com/oauth2/authorize?'+Object.entries({client_id:c.DISCORD_CLIENT_ID,response_type:'code',redirect_uri:c.SITE_URL,scope:'identify guilds.members.read',state}).map(([k,v])=>encodeURIComponent(k)+'='+encodeURIComponent(v)).join('&')};}
 if(action==='exchange'){
  if(typeof data.state!=='string'||typeof data.code!=='string'||data.code.length>1000)throw new Error('Invalid login.');
  const lock=LockService.getScriptLock();lock.waitLock(10000);try{if(cache_().get('oauth:'+data.state)!=='pending')throw new Error('Login expired. Please try again.');cache_().remove('oauth:'+data.state);}finally{lock.releaseLock();}
  const response=UrlFetchApp.fetch('https://discord.com/api/v10/oauth2/token',{method:'post',payload:{client_id:c.DISCORD_CLIENT_ID,client_secret:c.DISCORD_CLIENT_SECRET,grant_type:'authorization_code',code:data.code,redirect_uri:c.SITE_URL},muteHttpExceptions:true});
  if(response.getResponseCode()!==200)throw new Error('Discord login failed. Please try again.');const token=JSON.parse(response.getContentText());const user=discord_('/users/@me',token.access_token),member=membership_(token.access_token,c),key=random_(),ttl=Math.min(21600,Number(token.expires_in)||3600);
  cache_().put('session:'+key,JSON.stringify({discordId:user.id,displayName:member.nick||user.global_name||user.username,accessToken:token.access_token,expiresAt:Date.now()+ttl*1000}),ttl);return {session:key};
 }
 if(action==='logout'){if(typeof request.session==='string')cache_().remove('session:'+request.session);return {ok:true};}
 const s=session_(request.session,c);
 if(action==='roster'){const lock=LockService.getScriptLock();lock.waitLock(10000);let rows;try{rows=rows_(sheet_(c));}finally{lock.releaseLock();}const mine=rows.find(r=>r.discordId===s.discordId)||null;return {displayName:s.displayName,mine,roster:rows.map(({discordId,...r})=>r).sort((a,b)=>a.name.localeCompare(b.name))};}
 if(action==='save'||action==='remove'){
  const d=action==='save'?validate_(data):null,lock=LockService.getScriptLock();lock.waitLock(10000);
  try{const sheet=sheet_(c),rows=rows_(sheet),index=rows.findIndex(r=>r.discordId===s.discordId);if(action==='remove'){if(index>=0)sheet.deleteRow(index+2);return {ok:true};}
   const row=Object.assign({},d,{discordId:s.discordId,displayName:s.displayName,updatedAt:new Date().toISOString()});const values=HEADERS_.map(k=>safeCell_(String(row[k]||'')));const range=sheet.getRange(index>=0?index+2:sheet.getLastRow()+1,1,1,HEADERS_.length);range.setNumberFormat('@');range.setValues([values]);SpreadsheetApp.flush();return {ok:true};
  }finally{lock.releaseLock();}
 }
 throw new Error('Unknown action.');
}
